# Kukur Marketing AI: environment template. Copy to .env (git-ignored). Never commit real values.

# --- Database (production). Leave empty in local dev: an embedded Postgres (PGlite) is used in ./.data/pglite ---
DATABASE_URL=

# --- Dashboard access (single owner login) ---
ADMIN_PASSWORD=            # 12+ characters
SESSION_SECRET=            # 32+ random characters

# --- AI models (agents that need language reasoning) ---
AI_PROVIDER=auto           # auto | claude-cli | anthropic | ollama; ollama runs inference locally
AI_MODEL=                  # Ollama model name (default llama3.1); Anthropic model ID when AI_PROVIDER=anthropic
OLLAMA_BASE_URL=http://127.0.0.1:11434 # local Ollama server
ANTHROPIC_API_KEY=         # only needed for AI_PROVIDER=anthropic; never commit a real value
ANTHROPIC_MODEL=           # optional Anthropic model ID
AI_MONTHLY_BUDGET_USD=20   # the app stops model calls when this is reached
WEB_SEARCH_PROVIDER=google-news # google-news (no API key) | searxng (self-hosted)
SEARXNG_BASE_URL=           # e.g. http://127.0.0.1:8080; private network only

# --- Media storage (S3-compatible: Cloudflare R2 recommended). Local dev falls back to ./media ---
MEDIA_S3_ENDPOINT=         # https://<account>.r2.cloudflarestorage.com
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=     # public URL of the bucket (Meta must be able to fetch video files from here)

# --- Meta (Instagram + Facebook) ---
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0
META_PAGE_ID=              # Facebook Page id (Kukur Pet Store India)
META_IG_USER_ID=           # Instagram professional account id linked to that Page
META_PAGE_ACCESS_TOKEN=    # long-lived Page token (server-side only)

# --- Operations ---
APP_TIMEZONE=Asia/Kolkata
